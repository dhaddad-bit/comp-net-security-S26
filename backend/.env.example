NODE_ENV=production
PORT=3000

SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 32-byte key for AES-256-GCM encryption of OAuth tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=https://your-domain.example

# Use DATABASE_URL in production
DATABASE_URL=

# Production DB TLS. Default "disable" is correct when PostgreSQL is on the same
# host over loopback. If the DB is moved off-host, set DB_SSL=verify-full and
# point DB_CA_CERT at the server's CA bundle — certificate validation is always
# enforced (we never disable it).
DB_SSL=disable
DB_CA_CERT=

# Optional local DB split vars for development
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

RESEND_API_KEY=
INVITE_LINK_SECRET=
